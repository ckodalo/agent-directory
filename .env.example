PORT=3000
DB_CLIENT=sqlserver
DB_HOST=localhost
DB_NAME=agenttrust
DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
# Only for a local SQL Server with a self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=true
# Named instance: set DB_INSTANCE instead of DB_PORT.
# DB_INSTANCE=SQLEXPRESS
# DB_PORT=1433
# For SQL Server login authentication: DB_AUTH=sql, DB_USER and DB_PASSWORD.
# For MySQL: DB_CLIENT=mysql, DB_PORT=3306, DB_USER and DB_PASSWORD.
TRUST_PROXY=0
# Generate a local secret with npm run auth:setup; never commit your .env.
SESSION_SECRET=
# Set true with HTTPS; NODE_ENV=production always enables secure cookies.
SESSION_COOKIE_SECURE=false
